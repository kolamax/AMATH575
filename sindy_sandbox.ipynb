    "import numpy as np \n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Initial conditions:\n",
    "beta = 0.8\n",
    "sigma = 0.1\n",
    "p = 0.005\n",
    "N = 100\n",
    "\n",
    "def bifunc():\n",
    "    alpha_val = []\n",
    "    S_val = []\n",
    "    alpha = np.linspace(3, 4.2, 1000)\n",
    "    for a in alpha:\n",
    "        S = 70\n",
    "        I = 30\n",
    "        for iterations in range(1000):\n",
    "            S_temp = S\n",
    "            I_temp = I\n",
    "            S = (1. - p) * S_temp - (a / N) * I_temp * S_temp + beta * (N - S_temp)\n",
    "            I = (a / N) * I_temp * S_temp + (1 - beta - sigma) * I_temp\n",
    "            if S > 100000:\n",
    "                break\n",
    "            if I > 100000:\n",
    "                break\n",
    "            if iterations > 900:\n",
    "                S_val.append(S)\n",
    "                alpha_val.append(a)\n",
    "    plt.plot(alpha_val, S_val, ls='', marker=',')\n",
    "    plt.show()\n",
    "\n",
    "bifunc()"
   ]
  },
